#!/usr/bin/env python3
"""Token Monitor launcher.

Thin on purpose: it only makes the package importable when this file is symlinked into ~/.local/bin
(where the GNOME extension and the desktop entry call it from), then hands over to token_monitor.cli.

    ln -sfn ~/Development/token-monitor/bin/token-monitor ~/.local/bin/token-monitor
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from token_monitor.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
