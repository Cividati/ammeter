# Copy to .env (gitignored) and edit:  cp .env.example .env && chmod 600 .env
# Real environment variables win over this file. See docs/WIRING.md.

# github (default when `gh` is logged in to the host), curl, or mock.
# github = your personal Copilot seat quota in credits from api.<host>/copilot_internal/user; it is NOT
# necessarily an organisation budget portal's figure (that needs an SSO session: use curl for it).
# For GitHub Enterprise set the host, e.g. TOKEN_MONITOR_GH_HOST=github.example.com
#TOKEN_MONITOR_SOURCE=github
#TOKEN_MONITOR_GH_HOST=github.com
# skip `gh auth token`; a secret, keep this file chmod 600:
#TOKEN_MONITOR_GH_TOKEN=
# github: credits are shown as USD at this rate (30000 credits = $300); 0 shows raw credits
#TOKEN_MONITOR_CREDITS_PER_USD=100
# raw unit label (cr for github, EUR otherwise)
#TOKEN_MONITOR_UNIT=cr

# curl source: a shell command that prints the JSON response (alternatively use
# ~/.config/token-monitor/curl.sh). Contains your SSO cookie when pasted from DevTools - keep .env private.
#TOKEN_MONITOR_CURL_CMD=curl -sS --fail 'https://portal.example.com/...' -H 'cookie: ...'

# where the numbers sit in the JSON: budget=path,spent=path,currency=path,period_end=path
#TOKEN_MONITOR_JSON_MAP=budget=data.monthlyBudget,spent=data.spent

# fixed budget in the displayed unit (USD for github), overrides the one in the source (handy if the source only reports spend)
#TOKEN_MONITOR_BUDGET=300

# --- history and local usage -------------------------------------------------------------------
# where portal snapshots (history.jsonl) and the default plot (usage.svg) live; default ./.token-monitor
#TOKEN_MONITOR_HISTORY_DIR=

# local usage source: "opencode" (default with the curl source) reads OpenCode's SQLite db read-only,
# "mock" (default with the mock source) uses data/mock-history.json
#TOKEN_MONITOR_USAGE=opencode
#TOKEN_MONITOR_OPENCODE_DB=~/.local/share/opencode/opencode.db
#TOKEN_MONITOR_PROVIDERS=github-copilot

# OpenCode's cost is its own USD estimate, not what was billed. It only fills days that portal
# snapshots in the history do not cover. Unset = calibrated from the history when possible, else 1.
#TOKEN_MONITOR_COST_FACTOR=
